#!/usr/bin/env bash

set -ex

cd "$(dirname "$0")/.."

# Create config dir if not present
if [[ ! -d "${PWD}/config" ]]; then
    mkdir -p "${PWD}/config"
    hass --config "${PWD}/config" --script ensure_config
fi

# Expose custom_components/ to Home Assistant without symlinks, so the repo
# keeps the <root>/custom_components/adaptive_cover layout while HA reads its
# configuration from <root>/config.
export PYTHONPATH="${PYTHONPATH}:${PWD}/custom_components"

# Start Home Assistant
uv run hass --config "${PWD}/config" --debug
